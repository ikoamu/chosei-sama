{
  "name": "chosei-sama",
  "version": "1.0.0",
  "private": true,
  "description": "Google Workspace カレンダーから全員の空き時間を提案するチャットエージェント",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false",
    "format": "oxfmt --write .",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix",
    "check": "oxfmt --check . && oxlint src/ && tsc",
    "test": "vitest run",
    "quality": "fallow health --score --hotspots --targets"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "^0.8.0",
    "@cloudflare/kumo": "^2.4.1",
    "@phosphor-icons/react": "^2.1.10",
    "agents": "^0.16.0",
    "ai": "^6.0.194",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "workers-ai-provider": "^3.1.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@cloudflare/vite-plugin": "1.39.1",
    "@cloudflare/workers-types": "^4.20260602.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "fallow": "^2.100.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wrangler": "4.96.0"
  },
  "packageManager": "pnpm@11.8.0"
}
