# ローカル開発用シークレットのサンプル。
# このファイルをコピーして .dev.vars を作り、実値を記入してから `pnpm dev` する。
#   cp .dev.sample.vars .dev.vars
# .dev.vars は .gitignore 済み（コミットしない）。本番値は Cloudflare Secrets に置く。
#
# 事前に Google Cloud の OAuth クライアントへ、ローカルのリダイレクト URI
#   http://localhost:5173/oauth/callback
# を「承認済みのリダイレクト URI」として登録しておくこと。

GOOGLE_CLIENT_ID="<OAuth クライアント ID>"
GOOGLE_CLIENT_SECRET="<OAuth クライアントシークレット>"
ALLOWED_DOMAIN="<許可するドメイン 例: example.co.jp>"
COOKIE_SECRET="<任意のランダム文字列 例: openssl rand -hex 32>"
TYPESAFE_API_KEY="<TypeSafe AI の API キー（Jev）>"
